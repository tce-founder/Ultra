  "claims": {
    "claim:carb-ceiling": {
      "label": "The absorbable carbohydrate ceiling is ~90 g/h, and ~120 g/h with gut training",
      "why_it_matters": "It sets the race fuelling plan, the gut-training block that precedes it, and how much of a bad patch is read as a fuelling failure. The 120 g/h evidence is one small trial in elite men on a mountain marathon; the number travels far better than its population does."
    },
    "claim:sodium-prevents-cramp": {
      "label": "Sodium supplementation prevents cramping, dehydration and hyponatremia",
      "why_it_matters": "Widely believed and directly contradicted by the trial recorded in [[sodium-does-not-prevent-cramping]]. It is load-bearing in the opposite direction from most claims here: acting on it causes over-drinking, which is the actual mechanism of exercise-associated hyponatremia."
    },
    "claim:gi-leading-dnf": {
      "label": "GI distress is the leading cause of ultramarathon DNF",
      "why_it_matters": "If true it ranks gut training above most of the training plan. The underlying figures are from two named US 100-mile races and are about the stated PRIMARY reason for withdrawal, which is not the same as cause."
    },
    "claim:polarized-superiority": {
      "label": "A polarised ~80/20 intensity distribution beats other distributions",
      "why_it_matters": "It decides how every week is built. The systematic-review evidence supports low-intensity dominance far more strongly than it supports POLARISED specifically over pyramidal or threshold models."
    },
    "claim:vert-machine-equivalence": {
      "label": "An indoor climbing machine substitutes for real vertical gain",
      "why_it_matters": "It is the claim a treadmill-and-stair-machine winter rests on, and it is asymmetric: the machines reproduce the climbing demand reasonably and the DESCENDING demand not at all, which is where the race damage comes from."
    },
    "claim:minimum-effective-dose": {
      "label": "Roughly 6-10 h/week, held consistently, is enough to finish a long ultra",
      "why_it_matters": "It is the premise the whole time-management lens rests on, and the one with the weakest evidence base in this corpus \u2014 coaching assertion repeated across sources, not a measured finding."
    }
  }
}