DTSTART;TZID=America/New_York:20261020T060000
DTEND;TZID=America/New_York:20261020T062500
SUMMARY:W1 · Aerobic run (25m)
DESCRIPTION:Week 1 · Base 1 — tissue tolerance\\n\\nEasy\, conversationa
 l. No strides yet.
CATEGORIES:RUN
END:VEVENT
BEGIN:VEVENT
